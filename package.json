{
  "name": "distributed-job-scheduler",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "concurrently \"npm run start:api\" \"npm run start:scheduler\" \"npm run start:worker\"",
    "start:api": "node apps/api/dist/app.js",
    "start:scheduler": "node apps/scheduler/dist/index.js",
    "start:worker": "node apps/worker/dist/index.js",
    "build": "npm run build:all",
    "build:all": "npm run build --workspace=database && npm run build --workspace=observability && npm run build --workspace=shared && npm run build --workspace=@scheduler/api && npm run build --workspace=scheduler && npm run build --workspace=worker",
    "dev": "npm run dev --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "benchmark:create-jobs": "tsx benchmarks/create-10000-jobs.ts"
  },
  "dependencies": {
    "bullmq": "^5.79.1",
    "dotenv": "^17.4.2",
    "ioredis": "5.10.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^20.19.43",
    "autocannon": "^8.0.0",
    "concurrently": "^9.2.3",
    "typescript": "^5.9.3"
  }
}
