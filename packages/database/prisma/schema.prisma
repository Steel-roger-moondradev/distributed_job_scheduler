generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id             String   @id @default(cuid())
  name           String
  description    String?
  payload        Json
  type           String
  cronExpression String?
  active         Boolean  @default(true)
  priority       Int      @default(0)
  nextRunAt      DateTime?
  maxRetries     Int      @default(3)
  timeoutMs      Int      @default(30000)

  status JobStatus @default(ACTIVE)

  runs           JobRun[]
  failedJobs     FailedJob[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model JobRun {
  id          String   @id @default(cuid())

  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])

  status JobRunStatus

  startedAt DateTime @default(now())
  finishedAt  DateTime?
  error       String?
  duration    Int?
  workerId    String?
  attempts    Int           @default(1)

  createdAt   DateTime @default(now())
}

model FailedJob {
  id         String   @id @default(cuid())

  jobId      String
  payload    Json
  reason     String
  attempts   Int

  failedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())
}

enum JobRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}
enum JobStatus {
  ACTIVE
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}