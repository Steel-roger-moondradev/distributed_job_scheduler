generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id             String     @id @default(cuid())
  name           String
  description    String?
  payload        Json
  type           JobRunCategory
  jobtype        String
  cronExpression String?

  // Lifecycle of the job itself
  status         JobStatus  @default(ACTIVE)

  priority       Int        @default(0)
  nextRunAt      DateTime?
  maxRetries     Int        @default(3)
  timeoutMs      Int        @default(30000)

  runs           JobRun[]
  failedJobs     FailedJob[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, nextRunAt])
}

model JobRun {
  id String @id @default(cuid())

  jobId String
  job   Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Lifecycle of this particular execution
  status JobRunStatus

  startedAt  DateTime @default(now())
  finishedAt DateTime?
  error      String?
  result     Json?
  duration   Int?
  workerId   String?
  attempts   Int      @default(1)

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([status])
}

model FailedJob {
  id String @id @default(cuid())

  jobId    String
  payload  Json
  reason   String
  attempts Int

  failedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

enum JobStatus {
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum JobRunStatus {
  PENDING
  CLAIMED
  RUNNING
  SUCCESS
  FAILED
}

enum JobRunCategory {
  CRON
  ONCE
  DELAYED
}